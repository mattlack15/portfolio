[Unit]
Description=Persistent private movie cache
After=network.target

[Service]
Type=simple
User=ubuntu
Environment=MOVIE_CACHE_CONFIG=/home/ubuntu/.local/state/portfolio-movie-cache/config.json
ExecStart=/usr/bin/python3 /home/ubuntu/portfolio/scripts/cache-movie.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.local/state/portfolio-movie-cache

[Install]
WantedBy=multi-user.target
